# === Database (Postgres metadata only) ===
# Dùng Neon / Supabase Postgres / Railway — KHÔNG dùng Supabase Storage cho ảnh truyện.
# Supabase: Project Settings → Database → Connection string (URI), mode Transaction (pooler) hoặc Direct.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# === Cloudflare R2 (ảnh bìa + trang truyện) — $0 egress ===
# Dashboard: R2 → Create bucket → Settings → Public access / Custom domain
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=comicweb
R2_PUBLIC_BASE_URL="https://img.your-domain.com"

# === App ===
# JWT secret cho unlock cookie (Sprint 2)
UNLOCK_JWT_SECRET="change-me-to-a-long-random-string"
